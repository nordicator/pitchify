# Backend (set these on Railway/Render)
GEMINI_API_KEY=
FISH_AUDIO_API_KEY=

# Comma-separated frontend origins (Vercel *.vercel.app is already allowed via regex)
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Frontend (set this on Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000
